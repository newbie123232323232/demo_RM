# =============================================================================
# module_src — biến môi trường & hằng cấu hình
# Gom từ: Planning_doc/devplan_checklist.md + business_requirements.md
# =============================================================================
#
# Sao chép sang file local (không commit):
#   copy .env.example .env
#
# Lưu ý triển khai:
#   - .NET: map sang appsettings / User Secrets / biến hệ thống
#     (ví dụ ConnectionStrings__RevenueDb). Repo chưa tự load file .env.
#   - Angular: đồng bộ NG_* vào frontend/src/environments/environment.ts
#     (build-time; hoặc script generate nếu team thêm sau).
#
# =============================================================================

# --- PostgreSQL local (Step 0-B2, BRD §2.1) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=HMModule
POSTGRES_USER=hmuser
POSTGRES_PASSWORD=123456

# pgAdmin: Server name = MONI local | Host = localhost | Port = 5432
# Database = HMModule | User = hmuser | Password = khớp DATABASE_URL
DATABASE_URL=postgresql+asyncpg://hmuser:123456@localhost:5432/HMModule

# Npgsql — giá trị đưa vào ConnectionStrings:RevenueDb (ASP.NET Core)
RevenueDb=Host=localhost;Port=5432;Database=HMModule;Username=hmuser;Password=123456

# --- ASP.NET Core API (Step 0, launchSettings / devplan 0-T1) ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5093
API_PUBLIC_BASE_URL=http://localhost:5093

# --- Angular dev server (Step 0-F1, CORS) ---
ANGULAR_DEV_HOST=127.0.0.1
ANGULAR_DEV_PORT=4200
NG_API_BASE_URL=http://localhost:5093

# CORS — origins dev, cách nhau bởi dấu phẩy (Step 0-B4)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# --- Tiền tệ & thời gian (BRD §2; Step 4–5 filter & chart) ---
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Tuần lọc / trục X: bắt đầu thứ Hai — ISO (Step 5-B1)
APP_WEEK_STARTS_ON=Monday

# --- VipPoint: tích điểm sau Complete (BRD §3.2, Step 3-B4) ---
# Điểm nhận = floor(Payable / VIP_EARN_DIVISOR_VND), kiểu int
VIP_EARN_DIVISOR_VND=1000000

# --- VipPoint: đổi điểm / realtime preview % & trần (BRD §4.1–4.3, Step 2) ---
# p = 0 hoặc p >= VIP_REDEEM_MIN_POINTS; p thuộc {1..4} không hợp lệ
VIP_REDEEM_MIN_POINTS=5
# Số dư buyer tối thiểu khi dùng điểm (BRD §4.1 — đồng nhất 5 trong spec)
VIP_BUYER_MIN_BALANCE_TO_REDEEM=5

# Giảm theo %: mỗi điểm = VIP_DISCOUNT_PERCENT_OF_B_PER_POINT % của B
VIP_DISCOUNT_PERCENT_OF_B_PER_POINT=1

# Trần tuyệt đối: D_cap = VIP_DISCOUNT_CAP_NOMINAL_RATE * p * VIP_POINT_NOMINAL_VND
# (BRD: 0.2 * p * 1_000_000)
VIP_DISCOUNT_CAP_NOMINAL_RATE=0.2
VIP_POINT_NOMINAL_VND=1000000

# --- Voucher thường — biên validate (BRD §5.5, Step 2-F1) ---
VOUCHER_PERCENT_MIN=0
VOUCHER_PERCENT_MAX=100
VOUCHER_FIXED_AMOUNT_MIN_VND=0

# --- Page 1: debounce gọi POST /api/bills/preview (Step 2-F3, realtime) ---
BILL_PREVIEW_DEBOUNCE_MS=300

# --- Page 2: slider lọc Payable (Step 4-F2, BRD §8) ---
REVENUE_FILTER_PAYABLE_SLIDER_MAX_VND=100000000
REVENUE_FILTER_PAYABLE_SLIDER_MIN_VND=0

# --- API danh sách bill: bucket ngày|tuần|tháng (Step 4-B1) — gợi ý mặc định UI ---
BILLS_LIST_DEFAULT_BUCKET=day

# --- Báo cáo biểu đồ (Step 5-B1) ---
REVENUE_SERIES_DEFAULT_BUCKET=week

# --- Client HTTP timeout (Step 6-F1, gợi ý FE) ---
HTTP_CLIENT_TIMEOUT_MS=30000

# --- Postman / api-tests (Lessonlearn — đồng bộ baseUrl) ---
POSTMAN_BASE_URL=http://localhost:5093

# --- Chuẩn hóa lỗi Complete lặp (BRD §4.5, Step 6-B2) ---
HTTP_STATUS_BILL_COMPLETE_CONFLICT=409
ERROR_CODE_BILL_ALREADY_COMPLETED=bill_already_completed
